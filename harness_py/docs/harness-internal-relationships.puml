@startuml harness-internal-relationships

title harness_py — Internal Module Call Relationships

' 每个方块是一个文件，箭头表示「调用方 -> 被调用方」的方法层调用。
' prod 一轮研究 = 实线。

node "transport/service.py\nResearchHarnessService" as transport
node "orchestration/live_chat.py\nLiveResearchChatHarness" as livechat
node "orchestration/runtime.py\nbuild_harness_runtime()" as runtime
node "orchestration/agents/runtime.py\nAgentsSdkHarnessRuntime" as agents_runtime
node "orchestration/agents/context.py\nResearchRunContext" as ctx
node "orchestration/agents/tools.py\nbuild_agent_tools / call" as tools
node "orchestration/agents/model.py\nprovider_agents_model" as model
node "corpus/gateway.py\nJavaCorpusGateway" as gateway
node "corpus/tools.py\nReadingCorpusTools\n(reader facade)" as tools_facade
node "OpenAI Agents SDK\nRunner / Agent" as sdk

transport ..> livechat : run_job → run_turn
livechat ..> runtime : build_harness_runtime
runtime ..> agents_runtime : returns AgentsSdkHarnessRuntime
livechat ..> agents_runtime : runtime.run_turn(turn)
agents_runtime ..> ctx : turn → ResearchRunContext(...)
ctx ..> tools_facade : self.turn.corpus_reader
agents_runtime ..> tools : build_agent_tools(ctx)
agents_runtime ..> sdk : Runner.run(Agent(tools))
agents_runtime ..> tools : tool call dispatch
tools ..> tools_facade : search_paper_candidates / find_* / read_*
tools_facade ..> gateway : reader.search_papers / search_locations / read_locations
gateway ..> java : POST /internal/v1/corpus/*\n(HTTP, Java Corpus API)
tools ..> ctx : update authorized_paper_ids /\ndisclosed_location_refs /\nobservations_by_evidence_id
agents_runtime ..> tools : build_harness_run → final draft
agents_runtime ..> ctx : ctx.completed_at, ctx.total_tokens
agents_runtime ..> livechat : TurnExecutionResult(run)
livechat ..> ctx : build new ConversationState\n(updated_from_run)
livechat ..> transport : (Run dict,\nnew ConversationState)

@enduml
