@startuml review_04_research_turn_ports
!pragma layout smetana
title 04 Research Turn Runtime Collaboration: UML sequence with current ports

skinparam shadowing false
skinparam defaultFontName "Arial"
skinparam ArrowColor #334155
skinparam sequence {
  LifeLineBorderColor #94A3B8
  LifeLineBackgroundColor #F8FAFC
  ParticipantBorderColor #CBD5E1
  ParticipantBackgroundColor #F8FAFC
  BoxBorderColor #CBD5E1
  BoxBackgroundColor #F8FAFC
}

actor "Folio / Chat API" as Folio
participant "ChatHandler" as Chat #DBEAFE
participant "ConversationScopeService" as Scope #DBEAFE
participant "ChatGenerationStateService" as GenState #DBEAFE
participant "ConversationService" as Conv #DBEAFE
participant "ProductReadingConversationService" as PRCS #DBEAFE
participant "ResearchHarnessTransport\nHTTP or Redis" as Client #DBEAFE
participant "UsageQuotaService" as Quota #DBEAFE
participant "ResearchHarnessPayloadFactory" as PayloadFactory #DBEAFE
participant "ResearchHarnessResultMapper" as ResultMapper #DBEAFE
queue "Redis Streams\njobs/events/status/cancel" as Redis #EEF2FF
participant "RedisResearchWorker" as Worker #DCFCE7
participant "ResearchHarnessService" as RHS #DCFCE7
participant "LiveResearchChatHarness" as Live #DCFCE7
participant "AgentsSdkHarnessRuntime" as Runtime #DCFCE7
participant "Agent Runner" as Runner #DCFCE7
participant "ReadingCorpusTools" as Tools #DCFCE7
participant "JavaCorpusGatewayReader" as Gateway #FEF3C7
participant "InternalCorpusController" as Controller #FEF3C7
participant "CorpusRetrievalService" as Corpus #FEF3C7
participant "HybridReadingLocationRetriever" as Retriever #FEF3C7
participant "QdrantReadingLocationRetriever" as SparseRetriever #FEF3C7
participant "EmbeddingProvider" as Embeddings #FEF3C7
participant "CanonicalReadingLocationService" as Canonical #FEF3C7
database "Qdrant" as Qdrant #F8FAFC
database "MySQL" as MySQL #F8FAFC

Folio -> Chat : Q0 message + optional ProductReferenceFocus
activate Chat
Chat -> Scope : Q1 resolveForChat(user, conversation)
activate Scope
Scope --> Chat : effective scope
Chat -> Conv : optional resolve referenceNumber -> reference detail
activate Conv
Conv --> Chat : sourceQuoteRef / paperId / locationRef
deactivate Conv
Chat -> Scope : assertReferenceFocusWithinScope(...)
Chat -> GenState : createGeneration(user, client, conversation, message)
activate GenState
GenState --> Chat : generationId
deactivate GenState
Chat -> Scope : lockForFirstMessage(...)
Scope --> Chat : locked effective scope
deactivate Scope
Chat -> PRCS : Q2 submitTurn(userId, conversationId, generationId, message, lockedScope, effectiveScope)
activate PRCS

PRCS -> Conv : Q2a last 20 messages + latest reference mappings + readingStatePatch
activate Conv
Conv --> PRCS : history + previous_evidence + selected ids
deactivate Conv

PRCS -> Client : Q3 submit(ProductTurnRequest, progressListener)
activate Client
Client -> PayloadFactory : requestBody(request)
activate PayloadFactory
PayloadFactory --> Client : payload with scope.paper_ids + reference_focus + research_memory
deactivate PayloadFactory
Client -> Quota : reserveLlmTokens(estimate, maxCompletion)
activate Quota
Quota --> Client : TokenReservation
deactivate Quota

alt HTTP transport
  Client -> RHS : Q3a POST /v1/research/stream\nNDJSON progress/result
else Redis transport
  Client -> Redis : XADD job + status QUEUED
  Redis -> Worker : XREADGROUP job
  activate Worker
  Worker -> Redis : SET lock + heartbeat; status RUNNING
  Worker -> RHS : run_job(payload, event sink, cancel check)
end
activate RHS

RHS -> Gateway : Q4 reader(request_id, conversation_id, user_id, scope_paper_ids)
activate Gateway
Gateway --> RHS : JavaCorpusGatewayReader
deactivate Gateway
RHS -> Gateway : Q4a load_metadata_dataset()
activate Gateway
Gateway --> RHS : scoped paper-id shells
deactivate Gateway

RHS -> Live : Q5 run_turn(dataset, ConversationState, userMessage)
activate Live
Live -> Runtime : Q6 run_turn(TurnExecutionInput)
activate Runtime
Runtime -> Runtime : create ResearchRunContext\n+ ReadingCorpusTools + Session + Agent
Runtime -> Runner : Q6a Runner.run(agent, context)
activate Runner

loop required tool-use loop
  Runner -> Tools : Q7 function call
  activate Tools
  Tools --> Chat : progress event through transport listener
  Chat -> GenState : appendProgressEvent(...)
  alt get_research_skill
    Tools -> Tools : record skills_used only
  else search_paper_candidates / find_papers_by_identity
    Tools -> Gateway : /papers/search
    activate Gateway
    Gateway -> Controller : POST /internal/v1/corpus/papers/search
    activate Controller
    Controller -> Corpus : searchPapers / findPapersByIdentity
    activate Corpus
    Corpus -> MySQL : authorized papers + current READY models
    MySQL --> Corpus : PaperCard[]
    Corpus --> Controller : paper candidates
    deactivate Corpus
    Controller --> Gateway : candidates
    deactivate Controller
    Gateway --> Tools : model-facing paper cards
    deactivate Gateway
    Tools -> Tools : disclose authorized_paper_ids
  else find_reading_locations
    Tools -> Gateway : /locations/search
    activate Gateway
    Gateway -> Controller : POST /internal/v1/corpus/locations/search
    activate Controller
    Controller -> Corpus : searchLocations
    activate Corpus
    Corpus -> Retriever : hybrid retrieval request + active model filter
    activate Retriever
    Retriever -> SparseRetriever : sparse BM25 query
    activate SparseRetriever
    SparseRetriever -> Qdrant : searchLexical(vector, filter)
    Qdrant --> SparseRetriever : QdrantSearchHit[]
    SparseRetriever --> Retriever : sparse ranked refs
    deactivate SparseRetriever
    opt QDRANT_CONTRACT == sparse-dense-v1
      Retriever -> Embeddings : embed(query)
      activate Embeddings
      Embeddings --> Retriever : dense vector
      deactivate Embeddings
      Retriever -> Qdrant : searchDense(vector, filter)
      Qdrant --> Retriever : dense hits
      Retriever -> Retriever : ReciprocalRankFusion(sparse, dense)
    end
    Retriever --> Corpus : ranked location refs
    deactivate Retriever
    Corpus -> Canonical : hydrate selected previews
    activate Canonical
    Canonical -> MySQL : current Reading Model content
    MySQL --> Canonical : CanonicalLocation[]
    Canonical --> Corpus : preview content
    deactivate Canonical
    Corpus --> Controller : LocationCandidate[]
    deactivate Corpus
    Controller --> Gateway : non-citeable previews
    deactivate Controller
    Gateway --> Tools : location refs
    deactivate Gateway
    Tools -> Tools : disclose location_refs
  else read_locations
    Tools -> Gateway : /locations/read
    activate Gateway
    Gateway -> Controller : POST /internal/v1/corpus/locations/read
    activate Controller
    Controller -> Corpus : readLocations
    activate Corpus
    Corpus -> Canonical : read(location_refs, authorizedIds)
    activate Canonical
    Canonical -> MySQL : exact span_text + visual availability
    MySQL --> Canonical : CanonicalLocation[]
    Canonical --> Corpus : ReadBatch
    deactivate Canonical
    Corpus --> Controller : exact reads
    deactivate Corpus
    Controller --> Gateway : items
    deactivate Controller
    Gateway --> Tools : CanonicalLocation[]
    deactivate Gateway
    Tools -> Tools : create Evidence IDs\nobservations_by_evidence_id
  else submit_research_answer
    Tools -> Tools : validate sole final tool call\n+ known previous/current evidence
    Tools --> Runner : accepted final output or validation error
  end
  Tools --> Runner : model-facing result
  deactivate Tools
end

Runner --> Runtime : accepted run
deactivate Runner
Runtime --> Live : TurnExecutionResult
deactivate Runtime
Live --> RHS : run + next ConversationState
deactivate Live
RHS --> Client : result payload
deactivate RHS
opt Redis transport
  Worker -> Redis : XADD result/error/cancelled event
  Worker -> Redis : status SUCCEEDED/FAILED/CANCELLED + delete lock
  deactivate Worker
  Redis --> Client : XREAD terminal event
end

Client -> ResultMapper : toProductResult(request, response)
activate ResultMapper
ResultMapper --> Client : ProductTurnResult(answer, references, artifacts, state patch)
deactivate ResultMapper
Client -> Quota : settle actual total tokens\nor abort on failure
activate Quota
Quota --> Client : quota updated
deactivate Quota
Client --> PRCS : ProductTurnResult
deactivate Client
PRCS --> Chat : answer + references + product state
deactivate PRCS

Chat -> GenState : updateReferenceMappings / diagnostics / artifacts / state patch
Chat -> Conv : recordConversation(..., referenceMappings, effectiveScope, researchEvents, generationId)
activate Conv
Conv -> MySQL : persist conversation JSON fields
Conv --> Chat : conversationRecordId
deactivate Conv
Chat -> GenState : markCompleted(referenceMappings)
Chat --> Folio : streamed chunks + completion + referenceMappings
deactivate Chat

note right of Chat
Reference focus is structured input:
sourceQuoteRef, paperHandle, locationRef, and readingAction are validated
before they become ProductTurnRequest memory.
end note

note right of Tools
Authorization ladder:
paper disclosed -> location disclosed -> exact read -> Evidence ID -> accepted submission.
end note

note right of Qdrant
Navigation only.
Citeable text is reopened from MySQL by read_locations.
end note
@enduml
